# Settings for Airwaves in Docker. Copy this file to .env, then edit .env:
#   cp .env.example .env
# Lines starting with # are notes, or settings left at their defaults.
# After a change: docker compose up -d

# The name the Airwaves app shows for this server.
AIRWAVES_NAME=Airwaves

# Your time zone, for the logs
# (https://en.wikipedia.org/wiki/List_of_tz_database_time_zones).
TZ=America/New_York

# Where the weather is for: a US ZIP code, or a latitude and longitude
# (more precise; both, or neither). Nothing else uses it. Leave the ZIP
# empty to go without weather. The forecast comes from the US National
# Weather Service, so US locations only.
AIRWAVES_ZIP=
#AIRWAVES_LAT=40.7128
#AIRWAVES_LON=-74.0060

# The weather channel's display runs in a second container. Put a # in
# front of this line to go without it (then stop a display already
# running with: docker compose rm -sf weatherstar).
COMPOSE_PROFILES=weather

# Folders on this computer, next to compose.yml unless you give a full
# path. DATA holds settings, caches, yt-dlp and backups (data/backups);
# CHANNELS holds a folder per channel. Create them before the first start:
#   mkdir -p data channels
DATA=./data
CHANNELS=./channels
# MP3s to play under the weather (optional; otherwise the display's own).
#MUSIC=./music

# The user and group airwavesd runs as, which must be able to write to
# DATA and CHANNELS. On Linux, `id -u` and `id -g` print yours.
PUID=1000
PGID=1000

# Ports on this computer: the app and admin page, and the weather display.
PORT=8089
WEATHERSTAR_PORT=8090
# Listen on one address only (a LAN or Tailscale address); all by default.
#BIND=192.168.1.20

# A password for the admin page (http://<this computer>:8089/admin/) and
# its MCP endpoint for AI agents. Without one, anyone who can reach this
# computer can change your channels: leave it empty only on a network you
# trust, and never forward the port to the internet without it.
AIRWAVES_ADMIN_PASSWORD=

# A token the Airwaves app must send (the app's Settings > Token). Without
# one, anyone who can reach this computer can watch.
#AIRWAVES_TOKEN=

# Jellyfin channels need no settings here: sign in to your Jellyfin server
# on the admin page. Ask for a Jellyfin user just for Airwaves.

# HDHomeRun emulation, for Jellyfin Live TV, Emby, Channels DVR and VLC:
# on serves the lineup, an M3U playlist, the XMLTV guide and the streams
# on HDHR_PORT. The Airwaves app doesn't need it.
AIRWAVES_HDHR=off
HDHR_PORT=5004
# To have players find it on the LAN by themselves (Linux only; leave BIND
# unset), add host networking too:
#COMPOSE_FILE=compose.yml:compose.host.yml
