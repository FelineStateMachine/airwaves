<?xml version="1.0" encoding="utf-8"?>
<!-- Airwaves servers are usually plain http on a home network or tailnet.
     User-installed CAs are trusted too, for a server behind a private CA. -->
<network-security-config>
    <base-config cleartextTrafficPermitted="true">
        <trust-anchors>
            <certificates src="system" />
            <certificates src="user" />
        </trust-anchors>
    </base-config>
</network-security-config>
